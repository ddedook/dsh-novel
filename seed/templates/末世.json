{
  "version": 1,
  "aiGuidance": {
    "summary": "本模板面向末世丧尸/进化/基地生存向。适配强化感染规则、尸潮压力、基地建设与异能/晶核成长，以及物资稀缺与人性秩序；七区齐全。禁止抄修仙境界名与寿元体系；勿以法器丹药为主道具；勿写成星际舰队/义体植入主叙事（那是科幻主类）。",
    "sections": {
      "overview": "类型优先末世丧尸/进化/基建/种田/异能/重生；特殊要求写感染尺度、尸潮节奏、基地比重与信息差规则。",
      "role": "人物强化感染状态、末世前职业、所属基地/小队、异能与战斗定位、理智与感染风险。扩展可加编入资格、黑市身份。",
      "world": "安全区与废土、尸潮走廊、基地规则与物资货币、爆发史与各方势力（基地/军阀/掠夺者/科研）。",
      "timeline": "记爆发日、尸潮、建基、迁徙、关键战役与真相节点。",
      "outline": "卷主题偏生存立足、尸潮考验、人性裂痕、远征撤离；冲突含资源与人心。",
      "item": "物资武器载具晶核药剂与防御建材；稀缺度与消耗风险。扩展可加空间仓、净化装置。",
      "level": "异能/进化阶表：升级条件（晶核、击杀、觉醒）、能力与侵蚀代价。扩展可加异能属性系、失控阈值。",
      "creature": "生物含动物/异兽/灵植/灵体等（非人物）。种类用库表 kind 标量；主人可选绑人物。档案写清栖息、习性、能力与危险度。"
    }
  },
