{
  "version": 1,
  "aiGuidance": {
    "summary": "本模板面向星际航行、赛博朋克与硬科幻向。适配强化物种改造、舰队/公司政权、科技权限与植入；七区齐全。末世丧尸/基地进化请用「末世」主类模板。禁止抄修仙境界名与寿元体系；科技树可用能级认证表达。",
    "sections": {
      "overview": "类型优先科幻/星际/赛博/太空歌剧；跨界可点选末世作子类型，但主叙事勿默认丧尸基地。特殊要求写科技伦理、审查尺度。",
      "role": "物种/义体、舰职、阵营、植入权限与任务定位。扩展可加舰籍、通缉级。",
      "world": "行星空间站航线禁航区、殖民政治与公司帝国。扩展可加生态灾害带。",
      "timeline": "殖民战争、AI 事件、文明接触、叛乱节点。",
      "outline": "卷主题偏探索/战争/叛逃；冲突含政权与资源。",
      "item": "装备武器载具植入体数据AI；科技等级与副作用。扩展可加固件后门、绑定义体。",
      "level": "能级职级、认证门槛、算力/武器许可。扩展可加安保等级。",
      "creature": "生物含动物/异兽/灵植/灵体等（非人物）。种类用库表 kind 标量；主人可选绑人物。档案写清栖息、习性、能力与危险度。"
    }
  },
